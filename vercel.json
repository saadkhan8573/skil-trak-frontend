{
    "framework": "nextjs",
    "buildCommand": "next build",
    "functions": {
        "api/**/*.js": {
            "memory": 3008,
            "maxDuration": 300,
            "excludeFiles": "node_modules/canvas/**/*"
        },
        "pages/**/*.{js,ts,tsx,jsx}": {
            "memory": 3008,
            "maxDuration": 60,
            "excludeFiles": "node_modules/canvas/**/*"
        },
        "app/**/*.{js,ts,tsx,jsx}": {
            "memory": 3008,
            "maxDuration": 60,
            "excludeFiles": "node_modules/canvas/**/*"
        }
    },
    "regions": ["iad1"]
}
